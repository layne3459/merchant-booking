# ---- 应用 ----
NODE_ENV=development
API_PORT=3000
# 本地开发填 http://localhost:3000；上线改为 https 公网 API 地址（支付回调据此自动生成）
API_BASE_URL=http://localhost:3000
JWT_SECRET=change-me-to-random-32-chars
JWT_EXPIRES_IN=7d

# ---- 数据库 ----
DATABASE_URL=mysql://root:root@localhost:3306/merchant_booking

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- 微信小程序（也可在后台「店铺设置 → 微信与支付」配置，保存后优先使用后台设置）----
# 填写真实 AppID 后，pnpm dev:mini 会自动写入小程序 manifest，消除开发者工具 webapi_getwxaasyncsecinfo:fail
WX_APPID=wx_xxxxxxxx

# 小程序开发 API 地址（pnpm dev:mini 会自动检测局域网 IP 写入 apps/mini/.env.local）
# VITE_API_BASE=http://192.168.0.100:3000/api
WX_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# 微信支付（填真实商户号后，小程序预约可调起微信支付；留占位 1234567890 则自动模拟已付款）
WX_MCH_ID=1234567890
WX_API_V3_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WX_SERIAL_NO=证书序列号
WX_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_PLATFORM_CERT_PATH=./certs/wechatpay_platform.pem
# 已废弃：回调地址由 API_BASE_URL 自动生成，格式为 {API_BASE_URL}/api/pay/notify?shop=店铺ID
# WX_NOTIFY_URL=

# 订阅消息模板 ID（也可在后台配置）
WX_TPL_BOOKING_SUCCESS=
WX_TPL_BOOKING_REMIND=
WX_TPL_NEW_BOOKING=

# ---- 开发专用（上线前请关闭）----
# 已迁移至后台「店铺设置 → 微信与支付 → 手动输入绑定」；以下可删除
# ALLOW_MANUAL_PHONE_BIND=true

# ---- 后台 CORS（开发） ----
ADMIN_ORIGIN=http://localhost:5173
